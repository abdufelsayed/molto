{
  "name": "molto-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HOST=127.0.0.1 vite dev --host 127.0.0.1 --port 17389",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --workspace-root typecheck:typescript",
    "generate-api": "uv run --project ../.. --all-packages --inexact python ../../tooling/export_management_schema.py && openapi-typescript ../../packages/contracts/generated/openapi.json -o ../../packages/contracts/generated/api-types.ts",
    "test": "pnpm build && pnpm test:unit && playwright test",
    "test:unit": "node --test tests/proxy*.mjs tests/studio/*.test.ts tests/preferences/*.test.ts",
    "start": "HOST=${HOST:-127.0.0.1} PORT=${PORT:-17389} node .output/server/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@molto/contracts": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "^0.11.2",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "crossws": "^0.4.12",
    "idb": "^8.0.3",
    "ipaddr.js": "^2.5.0",
    "just-bash": "^3.6.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6",
    "nitro": "3.0.260903-beta",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8"
  },
  "packageManager": "pnpm@10.33.0"
}
