{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/styles.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/lib/api-types.ts",
    "src/lib/openapi.json",
    "pnpm-lock.yaml",
    ".output/",
    "dist/",
    "test-results/",
    "playwright-report/"
  ]
}
