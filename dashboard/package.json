{
  "name": "omlx-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "check": "oxfmt --check . && oxlint",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "generate-api": "uv run --project \"${OMLX_SOURCE:-..}\" python scripts/export_management_schema.py && openapi-typescript src/lib/openapi.json -o src/lib/api-types.ts",
    "test": "pnpm build && node --test tests/proxy*.mjs && playwright test",
    "start": "HOST=${HOST:-127.0.0.1} node .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "crossws": "^0.4.12",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6",
    "nitro": "3.0.260903-beta",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.3",
    "vite": "^8"
  },
  "packageManager": "pnpm@10.33.0"
}
